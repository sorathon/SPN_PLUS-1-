{
  "authenticationEnabled": false,
  "setupConfig": {
    "enabled": false,
    "url": "/your-auth-endpoint",
    "method": "POST",
    "body_type": "form-urlencoded",
    "payload": {
      "USERNAME": "__ENV.TEST_USERNAME",
      "PASSWORD": "__ENV.TEST_PASSWORD"
    },
    "extractors": {}
  },
  "executionMode": {
    "mode": "parallel",
    "sequentialDelay": "5s",
    "order": [],
    "groups": []
  },
  "thresholds": {
    "http_req_failed": [
      "rate<0.01"
    ]
  },
  "stageProfiles": {
    "defaultRamp": [
      {
        "duration": "10s",
        "target": 1
      },
      {
        "duration": "10s",
        "target": 2
      },
      {
        "duration": "10s",
        "target": 0
      }
    ]
  }
}
