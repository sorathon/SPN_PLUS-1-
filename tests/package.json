{
  "name": "spn-plus-automation",
  "version": "1.0.0",
  "description": "ShippingNet Pluz+ functional regression automation",
  "reportTitle": "SPN_PLUS Automation Test Results",
  "reportFeatureNames": {
    "export": "Export Declaration (ShippingNet Pluz+)",
    "import-declaration": "Import Declaration (ShippingNet Pluz+)",
    "zero-default": "DB Default 0 (Import / Export)",
    "other-report": "Other Report (Configuration)",
    "gcl": "Goods Transition Control (GCL)"
  },
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/run-tests.js --project=functional --grep @smoke",
    "gen:types": "openapi-typescript ../openapi/core.openapi.json -o generated/types.ts",
    "test:api": "playwright test --project=api",
    "test:functional": "playwright test --project=functional",
    "test:e2e": "playwright test --project=e2e",
    "test:import": "node scripts/run-tests.js --project=functional functional/import-declaration",
    "test:import:headed": "node scripts/run-tests.js --project=functional functional/import-declaration --headed",
    "test:import:all": "node scripts/run-tests.js --project=functional functional/import-declaration functional/zero-default/import.spec.ts functional/other-report/other-report.spec.ts --grep-invert \"Other Report · Export Report\"",
    "test:import:all:headed": "node scripts/run-tests.js --project=functional functional/import-declaration functional/zero-default/import.spec.ts functional/other-report/other-report.spec.ts --grep-invert \"Other Report · Export Report\" --headed",
    "test:export:list": "playwright test --project=export --list",
    "test:export:headed": "node scripts/run-tests.js --project=export --headed",
    "test:export:gcl:headed": "node scripts/run-tests.js --project=export functional/export/gcl.spec.ts --headed",
    "test:export:air:headed": "node scripts/run-tests.js --project=export functional/export/air-transport.spec.ts --headed",
    "test:export:short:headed": "node scripts/run-tests.js --project=export functional/export/create-short.spec.ts --headed",
    "test:item-duty:headed": "node scripts/run-tests.js --project=functional --project=export --grep \"TC-(FUNC|EXP)-028\" --headed",
    "test:item-preparation:headed": "node scripts/run-tests.js --project=functional --project=export --grep \"TC-(FUNC|EXP)-029\" --headed",
    "test:import:watch": "node scripts/run-tests.js --project=functional functional/import-declaration --headed --slow-mo=500",
    "test:import:ui": "playwright test --project=functional functional/import-declaration --ui",
    "test:zero:import": "node scripts/run-tests.js --project=functional functional/zero-default/import.spec.ts",
    "test:zero:export": "node scripts/run-tests.js --project=functional functional/zero-default/export.spec.ts",
    "test:zero:import:headed": "node scripts/run-tests.js --project=functional functional/zero-default/import.spec.ts --headed",
    "test:zero:export:headed": "node scripts/run-tests.js --project=functional functional/zero-default/export.spec.ts --headed",
    "test:report": "node scripts/run-tests.js --project=functional functional/other-report",
    "test:report:headed": "node scripts/run-tests.js --project=functional functional/other-report --headed",
    "test:perf": "k6 run performance/baseline.k6.js",
    "test:perf:enforce": "K6_PHASE=enforce k6 run performance/baseline.k6.js",
    "test:all": "playwright test",
    "test": "node scripts/run-tests.js",
    "test:email": "node scripts/run-tests.js --grep @email",
    "test:no-email": "node scripts/run-tests.js --grep-invert @email",
    "report": "playwright show-report",
    "qa-report": "node scripts/generate-report.js",
    "setup": "npx playwright install --with-deps && echo 'Ready! Copy .env.example to .env and configure.'",
    "test:gcl": "node scripts/run-gcl-tests.cjs",
    "test:gcl:headed": "node scripts/run-gcl-tests.cjs --headed",
    "test:gcl:list": "node -r ./scripts/prepare-gcl-local.cjs node_modules/@playwright/test/cli.js test --project=gcl --list",
    "test:gcl:new:headed": "node scripts/run-gcl-tests.cjs functional/gcl/new-control.spec.ts --headed",
    "test:gcl:csv:headed": "node scripts/run-gcl-tests.cjs functional/gcl/csv.spec.ts --headed",
    "test:gcl:send-files:headed": "node scripts/run-gcl-tests.cjs functional/gcl/send-files.spec.ts --headed",
    "test:export:send:headed": "node scripts/run-tests.js --project=export functional/export/send.spec.ts --headed",
    "test:export:send-files:headed": "node scripts/run-tests.js --project=export functional/export/send-files.spec.ts --headed",
    "test:export:cancel:headed": "node scripts/run-tests.js --project=export functional/export/cancel.spec.ts --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.0.0",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.0"
  }
}
