APP_BASE_URL=https://uatsch.nbgwhosting.com/lcb_import_new/spn/
API_BASE_URL=https://uatsch.nbgwhosting.com/lcb_import_new/spn/
LOGIN_URL=login.php
TEST_USER_USERNAME=
TEST_USER_PASSWORD=
# Optional accounts.
TEST_EDITOR_USERNAME=
TEST_EDITOR_PASSWORD=
TEST_VIEWER_USERNAME=
TEST_VIEWER_PASSWORD=
# Existing mapping verified on this UAT; choose another profile on other sites.
SPN_CSV_MAPPING_IMPORT=CUSDEC_TEST
SPN_CSV_MAPPING_EXPORT=
# Optional dd-mm-yyyy date with a known exchange rate.
# SPN_RATE_DATE=01-09-2026
# REPORT_DATE_FROM=2026-09-01
# REPORT_DATE_TO=2026-09-05
# Optional Export test master data: choose a currently effective, compatible set on your site.
# SPN_EX_TARIFF_SEARCH=
# SPN_EX_TARIFF=
# SPN_EX_STAT=
# SPN_EX_EXPORT_TARIFF=
# SPN_EX_PRIVILEGE=003
# SPN_EX_SEQUENCE=50001
# Keep failed Export drafts for UI investigation (passed drafts are still cleaned up).
# SPN_EXPORT_KEEP_FAILURES=1

# GCL: optional confirmed business oracles / isolated fixtures (CSV deferred).
# Optional previously created OWNED ACCEPT sources for a focused rerun; otherwise create fresh sources.
# SPN_GCL_SOURCE_REFS=
# Python with pypdf; this host can use the bundled Codex Python automatically.
# SPN_GCL_PYTHON=
# SPN_GCL_EXPECTED_VGM=
# SPN_GCL_DUPLICATE_ROWS=
# SPN_GCL_PROPORTION_GROSS=
# SPN_GCL_MIXED_REFS=
# SPN_GCL_MIXED_FOOTER=
# SPN_GCL_DAT=
# SPN_GCL_DAT_EXPECTED=
# SPN_GCL_STATUS_REF=
# External Send/Cancel remain disabled unless explicitly authorized for an owned UAT fixture.
# SPN_GCL_ENABLE_SEND_GUARD=0
# SPN_GCL_ALLOW_TRANSMIT=0
# SPN_GCL_SEND_REF=

# Owned zero-package Export fixture only, optional TC-GCL-103
SPN_GCL_ZERO_PACKAGE_REF=

# Reference for popup-only Validate (TC-GCL-121)
# SPN_GCL_VALIDATION_REF=HQVM400001676

# Optional CSV business assertions; leave LastEntry as observation until confirmed
# SPN_GCL_CSV_LAST_ENTRY_MODE=observe

# Optional read/download fixture for Send screen Export to / Print Form (no actual Send)
# SPN_GCL_SEND_FILES_REF=HQVM400001676

# TC-EXP-070: actual Send on a newly created Export draft; opt-in for an authorized run only
# SPN_EXPORT_ALLOW_TRANSMIT=0

# Read/download fixture for Export Send screen file and print tests (does not send customs)
# SPN_EXPORT_SEND_FILES_REF=HQVM200002038

# TC-EXP-071: actual cancellation on a fresh owned UAT Export, opt-in only
# SPN_EXPORT_ALLOW_CANCEL=0
